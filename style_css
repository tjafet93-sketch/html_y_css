/* ===== RESET ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* ===== VARIABLES ===== */
:root {
    --color-primario: #1f1f1f;
    --color-secundario: #0057ff;
    --color-fondo: rgba(31, 31, 31, 0.8);
    --color-texto: #ffffff;
    --color-card: rgba(255, 255, 255, 0.05);
}

/* ===== BODY ===== */
body {
    background-image: url('../imagenes/fondo.gif');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    font-family: Arial, sans-serif;
    color: var(--color-texto);
}

/* ===== HEADER ===== */
header.Encabezado {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    background: var(--color-fondo);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--color-secundario);
}

h1 {
    font-size: 1.4rem;
}

/* ===== NAV ===== */
nav ul {
    display: flex;
    gap: 15px;
}

.link {
    list-style: none;
}

a {
    text-decoration: none;
    color: var(--color-texto);
    padding: 6px 12px;
    border-radius: 20px;
    background-color: transparent;
    transition: 0.3s;
}

a:hover {
    background-color: var(--color-secundario);
}

/* ===== MENSAJE ===== */
#mensaje-bienvenida {
    background: linear-gradient(90deg, #0057ff, #00aaff);
    padding: 15px;
    text-align: center;
    font-size: 0.9rem;
}

/* ===== HERO / SOBRE MI ===== */
.part_nav {
    position: relative;
}

.imagen_1 {
    width: 100%;
    height: 80vh;
    object-fit: cover;
    filter: brightness(0.5);
}

.contenido {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    max-width: 600px;
}

.contenido h2 {
    font-size: 2rem;
    margin-bottom: 10px;
}

.contenido p {
    font-size: 1rem;
    line-height: 1.5;
}

button {
    margin-top: 10px;
    padding: 10px 15px;
    border: none;
    background-color: var(--color-secundario);
    color: white;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background-color: #003bb5;
}

/* ===== CONTENEDOR ===== */
.contenedor {
    width: 90%;
    max-width: 1100px;
    margin: auto;
    padding: 40px 0;
}

/* ===== TARJETAS ===== */
.part_link,
.part_final {
    background: var(--color-card);
    backdrop-filter: blur(8px);
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 25px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}

h2 {
    margin-bottom: 15px;
}

/* ===== PROYECTOS ===== */
.links ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

.links li a {
    display: block;
    padding: 15px;
    background: rgba(255,255,255,0.05);
    border-radius: 10px;
    text-align: center;
    transition: 0.3s;
}

.links li a:hover {
    transform: translateY(-5px);
    background: var(--color-secundario);
}

/* ===== GALERÍA ===== */
.galeria {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.galeria img {
    width: 100%;
    border-radius: 10px;
    transition: 0.3s;
}

.galeria img:hover {
    transform: scale(1.05);
}

/* ===== FORMULARIO ===== */
.contenido_final {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

input, textarea {
    padding: 10px;
    border-radius: 8px;
    border: none;
}

button[type="submit"] {
    margin-top: 10px;
}

/* ===== RESPONSIVE ===== */

/* MÓVIL */
@media (max-width: 768px) {

    nav ul {
        flex-direction: column;
        align-items: center;
    }

    .contenido {
        position: static;
        transform: none;
        padding: 20px;
    }
}

/* TABLET */
@media (min-width: 769px) and (max-width: 1024px) {

    .links ul {
        grid-template-columns: repeat(2, 1fr);
    }

    .galeria {
        grid-template-columns: repeat(3, 1fr);
    }
}

/* ESCRITORIO */
@media (min-width: 1025px) {

    .links ul {
        grid-template-columns: repeat(3, 1fr);
    }

    .galeria {
        grid-template-columns: repeat(4, 1fr);
    }
}




